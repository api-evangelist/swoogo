          "request": {
            "name": "Request an API token",
            "description": {
              "content": "Exchanges Base64-encoded client credentials for a bearer token using the OAuth2 client_credentials grant. Send the encoded key:secret in an Authorization Basic header and grant_type=client_credentials as a form-encoded body. The returned token expires after 30 minutes.",
              "type": "text/plain"
            },
